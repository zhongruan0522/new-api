# File path: /etc/systemd/system/nookmux.service
# sudo systemctl daemon-reload
# sudo systemctl start nookmux
# sudo systemctl enable nookmux
# sudo systemctl status nookmux
[Unit]
Description=NookMux Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/nookmux  # 注意修改路径
ExecStart=/path/to/nookmux/nookmux --port 3000 --log-dir /path/to/nookmux/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
